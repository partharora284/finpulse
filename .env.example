# =============================================================================
# FinPulse — Environment Configuration Template
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL credentials -------------------------------------------------
POSTGRES_USER=finpulse
POSTGRES_PASSWORD=finpulse_pw
POSTGRES_DB=finpulse_db

# POSTGRES_HOST: leave this as 'localhost' below.
#   - Running via `docker compose up` (the normal path): docker-compose.yml
#     explicitly overrides this to 'db' as a container environment variable
#     for the ingestor/dashboard services — Docker's internal DNS resolves
#     'db' to the database container. You do NOT need to edit this value
#     for the standard Docker workflow; the override happens automatically.
#   - Running a service natively on your host (e.g. `streamlit run app.py`
#     or `python scheduler.py` directly, for quick local debugging, with
#     `docker compose up -d db` providing just the database): 'localhost'
#     is correct here, since 'db' only resolves inside Docker's network and
#     will fail to connect ("could not translate host name 'db'") outside it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Ingestor configuration --------------------------------------------------
# Comma-separated list of Yahoo Finance tickers to track
TICKERS=^NSEI,SPY

# Historical lookback window fetched from yfinance (e.g. 6mo, 1y, 2y, 5y)
LOOKBACK_PERIOD=2y

# Rolling window (in trading days) used for annualized volatility
VOLATILITY_WINDOW=20

# How often (in minutes) the ingestor re-polls for fresh data
POLL_INTERVAL_MINUTES=1440

# Number of retry attempts for transient DB/network failures
MAX_RETRIES=5
RETRY_BACKOFF_SECONDS=5

# --- Dashboard / Drift detector configuration --------------------------------
# Window sizes (in trading days) used by the KS two-sample drift test
DRIFT_RECENT_WINDOW=20
DRIFT_BASELINE_WINDOW=60
DRIFT_P_VALUE_THRESHOLD=0.05
